<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>VAULT</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
  <link rel="stylesheet" href="style.css"/>
</head>
<body>
<header>
  <div class="logo">VAULT</div>
  <nav>
    {% for onto in data %}
      <a href="#onto-{{ onto.prefix }}">{{ onto.label }}</a>
    {% endfor %}
  </nav>
  <div class="header-meta">Generated: {{ generated_at }}</div>
</header>
<main>

  {# ── Summary strip ── #}
  <div class="summary-strip">
    {% for onto in data %}
    <div class="summary-card">
      <h3>{{ onto.full_name }} ({{ onto.label }})</h3>
      <div class="uri">{{ onto.uri }}</div>
      <div class="metrics">
        <div class="metric">
          <span class="metric-value">{{ onto.openalex.total_works }}</span>
          <span class="metric-label">Works</span>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>

  {# ── Per-ontology sections ── #}
  {% for onto in data %}
  <section class="onto-section" id="onto-{{ onto.prefix }}">

    <div class="section-header">
      <h2>{{ onto.full_name }} ({{ onto.label }})</h2>
      <span class="uri-badge">{{ onto.uri }}</span>
    </div>

     <div class="section-accordion">
      <div class="section-accordion-header" onclick="toggleAccordion('work-section-{{ onto.prefix }}', this)">
        <h3>Scholarly works</h3>
        <span class="accordion-icon">⮝</span>
      </div>
      <div id="work-section-{{ onto.prefix }}" class="accordion-body">
        <div class="grid-3">
          <div class="card-stat">
            <span class="big-num">{{ onto.openalex.total_works }}</span>
            <span class="stat-label">works mentioned {{ onto.label }} in their titles, abstracts or texts</span>
          </div>
          <div class="card-stat">
            <span class="big-num">{{ onto.openalex.authors_count }}</span>
            <span class="stat-label">scholars mentioned {{ onto.label }} in their works</span>
          </div>
          <div class="card-stat">
            <span class="big-num">{{ onto.openalex.venues_count }}</span>
            <span class="stat-label">venues published works mentioning {{ onto.label }}</span>
          </div>
        </div>
        <div class="grid-1">
          <div class="card card-table full-width">
            <div class="card-header">
              <span class="source-tag oax-tag">OpenAlex</span>
              <h4>Which scholarly works mention {{ onto.label }}?</h4>
            </div>
            <div class="table-responsive-wrapper">
              <table class="card-table-content data-table-collapsible" id="table-oax-{{ onto.prefix }}">
                <thead>
                  <tr>
                    <th>Title</th>
                    <th>Authors</th>
                    <th>Year</th>
                    <th>Venue</th>
                    <th>DOI</th>
                  </tr>
                </thead>
                <tbody>
                  {% for work in onto.openalex.works %}
                  <tr class="{{ 'hidden-row' if loop.index > 5 else '' }}">
                    <td>{{ work.title }}</td>
                    <td>{{ work.authors }}</td>
                    <td>{{ work.year }}</td>
                    <td>{{ work.source_name }}</td>
                    <td>
                      {% if work.doi %}
                        <a href="{{ work.doi }}" target="_blank">{{ work.doi }}</a>
                      {% else %}
                        <span></span>
                      {% endif %}
                    </td>
                  </tr>
                  {% else %}
                  <tr><td colspan="5">No works found</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            {% if onto.openalex.works | length > 5 %}
              <button class="card-table-toggle-btn" data-target="table-oax-{{ onto.prefix }}" onclick="toggleCardTable(this)">
                Show More (+{{ onto.openalex.works | length - 5 }} more)
              </button>
            {% endif %}
          </div>
        </div>
        <div class="grid-2">
          <div class="card">
            <div class="card-header">
              <span class="source-tag oax-tag">OpenAlex</span>
              <h3>How many works have mentioned {{ onto.label }} in time?</h3>
            </div>
            <div class="card-detail">
              <div class="card-chart-detail">
                <canvas id="chart-bar-oax-{{ onto.prefix }}"></canvas>
              </div>
            </div>
          </div>
          <div class="card">
            <div class="card-header">
              <span class="source-tag oax-tag">OpenAlex</span>
              <h3>In which venues were published the works mentioning {{ onto.label }}?</h3>
            </div>
            <div class="card-detail">
              <div class="card-chart-detail">
                <canvas id="chart-venue-oax-{{ onto.prefix }}"></canvas>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>


    <script>

      function toggleAccordion(contentId, headerElement) {
        var content = document.getElementById(contentId);
        content.classList.toggle('open');
        headerElement.classList.toggle('active');
        
        if (content.classList.contains('open')) {
          setTimeout(function() {
            window.dispatchEvent(new Event('resize'));
          }, 10); 
        }
      }

      function toggleCardTable(button) {
        const targetId = button.getAttribute('data-target');
        const table = document.getElementById(targetId);
        if (!table) return;

        const isExpanded = table.classList.contains('expanded');
        const totalRows = table.querySelectorAll('tbody tr').length;
        const hiddenCount = totalRows - 3;

        if (isExpanded) {
            table.classList.remove('expanded');
            button.textContent = `Show More (+${hiddenCount} more)`;
            button.closest('.card').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
            table.classList.add('expanded');
            button.textContent = "Show Less";
        }
      }

      (function() {
        var ctx = document.getElementById('chart-bar-oax-{{ onto.prefix }}');
        if (!ctx) return;
        var oaxBarData = {{ onto.openalex.by_year | tojson }}
        new Chart(ctx, {
          type: 'bar',
          data: {
            labels: Object.keys(oaxBarData),
            datasets: [{
              label: 'Works per year',
              data: Object.values(oaxBarData),
              backgroundColor: '#15196b3f',
              borderColor: '#15196b',
              borderWidth: 1,
              borderRadius: 3,
            }]
          },
          options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
              y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: 'rgba(255,255,255,0.05)' } },
              x: { grid: { display: false } }
            }
          }
        });
      })();

      (function() {
        var ctx = document.getElementById('chart-venue-oax-{{ onto.prefix }}');
        if (!ctx) return;
        var venueData = {{ onto.openalex.sources | tojson }};
        var sortedVenueData = Object.entries(venueData).sort((a, b) => b[1] - a[1]);
        var labels = [];
        var data = [];
        var otherCount = 0;
        sortedVenueData.forEach(function(item, index) {
            if (index < 5) {
                labels.push(item[0]);
                data.push(item[1]);
            } else {
                otherCount += item[1];
            }
        });
        if (otherCount > 0) {
            labels.push('Other venues');
            data.push(otherCount);
        }
        new Chart(ctx, {
          type: 'doughnut',
          data: {
            labels: labels,
            datasets: [{
              data: data,
              backgroundColor: ['#15196b', '#35495e', '#41b883', '#f39c12', '#d9534f', '#bdc3c7'],
              borderWidth: 1
            }]
          },
          options: {
            responsive: true,
            plugins: {
              legend: { position: 'right', labels: { boxWidth: 12 } }
            }
          }
        });
      })();

    </script>

  </section>
  {% endfor %}

</main>

<footer>
  <span>Sources: LOV · GitHub · OpenAlex</span>
  <span>Generated automatically via GitHub Actions · {{ generated_at }}</span>
</footer>

</body>
</html>