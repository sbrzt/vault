<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>VAULT</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
  <link rel="stylesheet" href="style.css"/>
</head>
<body>
<header>
  <div class="logo">VAULT</div>
  <nav>
    {% for onto in data %}
      <a href="#onto-{{ onto.prefix }}">{{ onto.label }}</a>
    {% endfor %}
  </nav>
  <div class="header-meta">Generated: {{ generated_at }}</div>
</header>
<main>

  {# ── Summary strip ── #}
  <div class="summary-strip">
    {% for onto in data %}
    <div class="summary-card">
      <h3>{{ onto.full_name }} ({{ onto.label }})</h3>
      <div class="uri">{{ onto.uri }}</div>
      <div class="metrics">
        <div class="metric">
          <span class="metric-value">{{ onto.lov.inlinks }}</span>
          <span class="metric-label">Vocabularies (LOV)</span>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>

  {# ── Per-ontology sections ── #}
  {% for onto in data %}
  <section class="onto-section" id="onto-{{ onto.prefix }}">

    <div class="section-header">
      <h2>{{ onto.full_name }} ({{ onto.label }})</h2>
      <span class="uri-badge">{{ onto.uri }}</span>
    </div>

    <h3>Vocabularies</h3>

    <div class="grid-2">

      {# LOV card #}
      <div class="card">
        <div class="card-header">
          <span class="source-tag lov-tag">LOV</span>
          <h4>Which vocabularies reuse {{ onto.label }}?</h4>
        </div>
        <div class="card-stat">
          <span class="big-num">{{ onto.lov.inlinks }}</span>
          <span class="stat-label">vocabularies import, expand or specialize {{ onto.label }}</span>
        </div>
        <div class="card-detail">
          <ul class="compact-list">
            {% for vocab in onto.lov.using_vocabs %}
              <li><a href="{{ vocab.uri }}" target="_blank">{{ vocab.title or vocab.uri }}</a></li>
            {% else %}
              <li><em>None found</em></li>
            {% endfor %}
          </ul>
          {% if onto.lov.url %}
            <a class="styled-link lov-link" href="{{ onto.lov.url }}" target="_blank">View in LOV →</a>
          {% endif %}
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <span class="source-tag lov-tag">LOV</span>
          <h3>Domain categorization</h3>
        </div>
        <div class="card-detail">
            <canvas id="chart-keywords-lov-{{ onto.prefix }}" height="100"></canvas>
        </div>
      </div>
    
    </div>

    <div class="grid-2">

      <div class="card">
        <div class="card-header">
          <span class="source-tag lov-tag">LOV</span>
          <h3>Adoption timeline</h3>
        </div>
        <div class="card-detail">
            <canvas id="chart-timeline-lov-{{ onto.prefix }}" height="100"></canvas>
        </div>
      </div>

    </div>

    <script>

      (function() {
        var ctx = document.getElementById('chart-keywords-lov-{{ onto.prefix }}');
        if (!ctx) return;
        var keywordData = {{ onto.lov.keyword_frequencies | tojson }};
        new Chart(ctx, {
          type: 'doughnut',
          data: {
            labels: Object.keys(keywordData),
            datasets: [{
              label: 'Keyword frequencies',
              data: Object.values(keywordData),
              borderWidth: 1,
              borderRadius: 3,
            }]
          },
          options: {
            responsive: true,
            plugins: { 
              legend: { position: 'right' } 
            },
          }
        });
      })();

      (function() {
        var ctx = document.getElementById('chart-timeline-lov-{{ onto.prefix }}');
        if (!ctx) return;
        var timelineData = {{ onto.lov.adoption_timeline | tojson }};
        new Chart(ctx, {
          type: 'line',
          data: {
            labels: Object.keys(timelineData),
            datasets: [{
              label: 'Cumulative adoptions',
              data: Object.values(timelineData),
              fill: true,
              borderColor: 'rgb(75, 192, 192)',
              backgroundColor: 'rgba(75, 192, 192, 0.2)',
              tension: 0.3,
            }]
          },
          options: {
            responsive: true,
            plugins: { 
              legend: { display: false } 
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: { stepSize: 1 }
              }
            }
          }
        });
      })();

    </script>

  </section>
  {% endfor %}

</main>

<footer>
  <span>Sources: LOV · GitHub · OpenAlex</span>
  <span>Generated automatically via GitHub Actions · {{ generated_at }}</span>
</footer>

</body>
</html>