<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>VAULT</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
  <link rel="stylesheet" href="style.css"/>
</head>
<body>
<header>
  <div class="logo">VAULT</div>
  <nav>
    {% for onto in data %}
      <a href="#onto-{{ onto.prefix }}">{{ onto.label }}</a>
    {% endfor %}
  </nav>
  <div class="header-meta">Generated: {{ generated_at }}</div>
</header>
<main>

  {# ── Summary strip ── #}
  {% include "summary_section.html.j2" %}

  {# ── Dimensions sections ── #}
  {% for onto in data %}
  <section class="onto-section" id="onto-{{ onto.prefix }}">

    <div class="section-header">
      <h2>{{ onto.full_name }} ({{ onto.label }})</h2>
      <span class="uri-badge">{{ onto.uri }}</span>
    </div>

    {% include "vocabularies_section.html.j2" %}

    {% include "software_section.html.j2" %}

    {% include "works_section.html.j2" %}


    <script>

      function toggleAccordion(contentId, headerElement) {
        var content = document.getElementById(contentId);
        content.classList.toggle('open');
        headerElement.classList.toggle('active');
        
        if (content.classList.contains('open')) {
          setTimeout(function() {
            window.dispatchEvent(new Event('resize'));
          }, 10); 
        }
      }

      (function() {
        var ctx = document.getElementById('chart-keywords-lov-{{ onto.prefix }}');
        if (!ctx) return;
        var keywordData = {{ onto.lov.keyword_frequencies | tojson }};
        new Chart(ctx, {
          type: 'doughnut',
          data: {
            labels: Object.keys(keywordData),
            datasets: [{
              label: 'Keyword frequencies',
              data: Object.values(keywordData),
              borderWidth: 1,
              borderRadius: 3,
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { 
              legend: { position: 'right' } 
            },
          }
        });
      })();

      (function() {
        var ctx = document.getElementById('chart-timeline-lov-{{ onto.prefix }}');
        if (!ctx) return;
        var timelineData = {{ onto.lov.adoption_timeline | tojson }};
        new Chart(ctx, {
          type: 'line',
          data: {
            labels: Object.keys(timelineData),
            datasets: [{
              label: 'Cumulative adoptions',
              data: Object.values(timelineData),
              fill: true,
              borderColor: 'rgb(75, 192, 192)',
              backgroundColor: 'rgba(75, 192, 192, 0.2)',
              tension: 0.3,
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { 
              legend: { display: false } 
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: { stepSize: 1 }
              }
            }
          }
        });
      })();

      (function() {
        var ctx = document.getElementById('chart-category-github-{{ onto.prefix }}');
        if (!ctx) return;
        var categoryData = {{ onto.github.total_by_category | tojson }};
        new Chart(ctx, {
          type: 'bar',
          data: {
            labels: Object.keys(categoryData),
            datasets: [{
              label: 'Cumulative adoptions',
              data: Object.values(categoryData),
              backgroundColor: '#8561fa49',
              borderColor: '#7554e4',
              borderWidth: 1,
              borderRadius: 3,
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { 
              legend: { display: false } 
            },
            scales: {
              y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: 'rgba(255,255,255,0.05)' } },
              x: { grid: { display: false } }
            }
          }
        });
      })();

      (function() {
        var ctx = document.getElementById('chart-owner-github-{{ onto.prefix }}');
        if (!ctx) return;
        var ownerData = {{ onto.github.owner_frequencies | tojson }};
        new Chart(ctx, {
          type: 'doughnut',
          data: {
            labels: Object.keys(ownerData),
            datasets: [{
              label: 'Owner frequencies',
              data: Object.values(ownerData),
              borderWidth: 1,
              borderRadius: 3,
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { 
              legend: { position: 'right' } 
            },
          }
        });
      })();

      function toggleCardTable(button) {
        const targetId = button.getAttribute('data-target');
        const table = document.getElementById(targetId);
        if (!table) return;

        const isExpanded = table.classList.contains('expanded');
        const totalRows = table.querySelectorAll('tbody tr').length;
        const hiddenCount = totalRows - 3;

        if (isExpanded) {
            table.classList.remove('expanded');
            button.textContent = `Show More (+${hiddenCount} more)`;
            button.closest('.card').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
            table.classList.add('expanded');
            button.textContent = "Show Less";
        }
      }

      (function() {
        var ctx = document.getElementById('chart-bar-oax-{{ onto.prefix }}');
        if (!ctx) return;
        var oaxBarData = {{ onto.openalex.by_year | tojson }}
        new Chart(ctx, {
          type: 'bar',
          data: {
            labels: Object.keys(oaxBarData),
            datasets: [{
              label: 'Works per year',
              data: Object.values(oaxBarData),
              backgroundColor: '#5c28ebaf',
              hoverBackgroundColor: '#852ef6a9',
              borderColor: '#852ef6a9',
              borderWidth: 1,
              borderRadius: 3,
            }]
          },
          options: {
            responsive: true,
            plugins: { 
              legend: { 
                display: false 
              } 
            },
            scales: {
              y: { 
                beginAtZero: true, 
                ticks: { 
                  stepSize: 1 
                }, 
                grid: { 
                  color: '#bebebe78' 
                } 
              },
              x: {  
                grid: { 
                  color: '#bebebe78' 
                } 
              }
            }
          }
        });
      })();

      (function() {
        var ctx = document.getElementById('chart-venue-oax-{{ onto.prefix }}');
        if (!ctx) return;
        var venueData = {{ onto.openalex.sources | tojson }};
        var topVenues = Object.entries(venueData)
          .filter(item => item[0] && String(item[0]).trim() !== '' && String(item[0]) !== 'null') 
          .sort((a, b) => b[1] - a[1])
          .slice(0, 5);
        
        new Chart(ctx, {
          type: 'bar',
          data: {
            labels: topVenues.map(item => item[0].match(/.{1,40}(\s|$)/g) || [item[0]]),
            datasets: [{
              data: topVenues.map(item => item[1]),
              backgroundColor: '#5c28ebaf',
              hoverBackgroundColor: '#852ef6a9',
              borderColor: '#852ef6a9',
              borderWidth: 1,
              borderRadius: 3,
            }]
          },
          options: {
            responsive: true,
            indexAxis: 'y',
            plugins: { 
              legend: { 
                display: false 
              } 
            },
            scales: {
              y: { 
                beginAtZero: true, 
                ticks: { 
                  stepSize: 1,
                  autoSkip: false
                }, 
                grid: { 
                  color: '#bebebe78' 
                } 
              },
              x: {  
                grid: { 
                  color: '#bebebe78' 
                } 
              }
            },
          }
        });
      })();

    </script>

  </section>
  {% endfor %}

</main>

<footer>
  <span>Sources: LOV · GitHub · OpenAlex</span>
  <span>Generated automatically via GitHub Actions · {{ generated_at }}</span>
</footer>

</body>
</html>