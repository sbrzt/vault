<div class="section-accordion">
    <div class="section-accordion-header" onclick="toggleAccordion('vocab-section-{{ onto.prefix }}', this)">
        <h3>Reuse in vocabularies</h3>
        <span class="accordion-icon">⮝</span>
    </div>
    <div id="vocab-section-{{ onto.prefix }}" class="accordion-body">
        <div class="grid-3">
            <div class="card-stat">
                <span class="big-num">{{ onto.lov.inlinks }}</span>
                <span class="stat-label">vocabularies import, expand or specialize {{ onto.label }}</span>
            </div>
            <div class="card-stat">
                <span class="big-num">{{ onto.lov.lifespan_years }}</span>
                <span class="stat-label">years of continuous presence, since start</span>
            </div>
            <div class="card-stat">
                <span class="big-num">{{ onto.lov.versions | length }}</span>
                <span class="stat-label">versions of {{ onto.label }} indexed in LOV</span>
            </div>
        </div>
        <div class="grid-2">
            <div class="card">
                <div class="card-header">
                    <span class="source-tag lov-tag">LOV</span>
                    <h3>How was {{ onto.label }} adopted in time by other vocabularies?</h3>
                </div>
                <div class="card-detail">
                    <div class="card-chart-detail">
                        <canvas id="chart-timeline-lov-{{ onto.prefix }}"></canvas>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <span class="source-tag lov-tag">LOV</span>
                    <h3>In which domains is {{ onto.label }} being reused by other vocabularies?</h3>
                </div>
                <div class="card-detail">
                    <div class="card-chart-detail">
                        <canvas id="chart-keywords-lov-{{ onto.prefix }}"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="grid-1">
            <div class="card card-table full-width">
                <div class="card-header">
                    <span class="source-tag lov-tag">LOV</span>
                    <h4>Which vocabularies reuse {{ onto.label }}?</h4>
                </div>
                <div class="table-responsive-wrapper">
                    <table class="card-table-content data-table-collapsible" id="table-lov-{{ onto.prefix }}">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>URI</th>
                                <th>Year</th>
                                <th>Keywords</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for vocab in onto.lov.using_vocabs %}
                                <tr class="{{ 'hidden-row' if loop.index > 5 else '' }}">
                                    <td>{{ vocab.title }}</td>
                                    <td>
                                        <a href="{{ vocab.uri }}">
                                            {{ vocab.uri }}
                                        </a>
                                    </td>
                                    <td>{{ vocab.issued or '—' }}</td>
                                    <td>
                                        {% for keyword in vocab.keywords %}
                                            <span class="keyword-badge">
                                                {{ keyword }}
                                            </span>
                                        {% endfor %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="3">
                                        No vocabularies found
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if onto.lov.using_vocabs | length > 5 %}
                    <button class="card-table-toggle-btn" data-target="table-lov-{{ onto.prefix }}" onclick="toggleCardTable(this)">
                        Show more (+{{ onto.lov.using_vocabs | length - 5 }} more)
                    </button>
                {% endif %}
                {% if onto.lov.url %}
                    <a class="styled-link lov-link" href="{{ onto.lov.url }}" target="_blank">View in LOV →</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>